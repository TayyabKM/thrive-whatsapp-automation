PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# WhatsApp API (plug in when ready)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=thrive_verify_token
WHATSAPP_API_BASE=https://graph.facebook.com/v18.0
# App secret from Meta App → Settings → Basic. Verifies the X-Hub-Signature-256
# header on inbound webhook POSTs so requests can't be spoofed. Leave blank to
# skip verification (local dev without a Meta app yet).
WHATSAPP_APP_SECRET=

# AI message classifier (marks messages as important + why).
# Uses Groq by default; works with any OpenAI-compatible endpoint.
# Without a key the backend falls back to a keyword heuristic.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
CLASSIFIER_MODEL=qwen/qwen3.8-27b

# Dashboard access key. Set this before deploying anywhere reachable off your
# laptop — the frontend will show a lock screen and send it on every request.
# Leave blank for local dev (API stays open).
DASHBOARD_API_KEY=
